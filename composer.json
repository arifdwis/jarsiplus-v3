{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "cviebrock/eloquent-sluggable": "^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.7|^3.0",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.11",
        "laravel/tinker": "^2.9",
        "laravelcollective/html": "*",
        "league/flysystem-aws-s3-v3": "^3.0",
        "novay/nue": "*",
        "novay/sso-client": "*",
        "nue-extensions/backup": "*",
        "nue-extensions/env": "*",
        "nue-extensions/lockscreen": "*",
        "nue-extensions/settings": "*",
        "nwidart/laravel-modules": "^11.0|^12.0",
        "ramsey/uuid": "^4.7",
        "yajra/laravel-datatables-oracle": "^11.0|^12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/html"
        },
        {
            "type": "path",
            "url": "packages/nue"
        },
        {
            "type": "path",
            "url": "packages/sso-client"
        },
        {
            "type": "path",
            "url": "packages/nue-extensions/*"
        }
    ],
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "replace": {
        "fruitcake/laravel-cors": "*",
        "facade/ignition": "*",
        "torchlight/torchlight-laravel": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/" 
        },
        "files": [
            "app/Helpers/Enterwind.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
